# Discord bot token — Developer Portal → your app → Bot → Reset Token
DISCORD_TOKEN=

# Application (client) ID — Developer Portal → your app → General Information
DISCORD_CLIENT_ID=

# Your BaseDesk base URL (the agent dashboard origin)
BASEDESK_URL=http://localhost:4010

# Optional — register slash commands instantly in one server instead of globally.
# Enable Developer Mode in Discord, right-click the server → Copy Server ID.
GUILD_ID=

# Optional — HMAC signing secret. Set the SAME value as the channel's inbound
# signing secret in BaseDesk (Settings → Channels) to sign every request.
BASEDESK_SIGNING_SECRET=

# Optional — how often (ms) to check the dashboard for new replies to post back.
POLL_MS=4000
